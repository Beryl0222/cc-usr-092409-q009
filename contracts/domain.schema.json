{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "医者荣誉贡献档案领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROFILE_REGISTERED",
        "NOMINATION_SUBMITTED",
        "NOMINATION_VOTED",
        "CONTRIBUTION_DECLARED",
        "CONTRIBUTION_ACKNOWLEDGED",
        "EVIDENCE_SUBMITTED",
        "OFFLINE_CONFIRMATION_RECORDED",
        "DUPLICATE_MERGED",
        "EVIDENCE_CONFLICT_FLAGGED",
        "EVIDENCE_CONFLICT_RESOLVED",
        "ATTRIBUTION_SUGGESTED",
        "ATTRIBUTION_ADJUDICATED",
        "DISPUTE_FILED",
        "DISPUTE_RESOLVED",
        "ATTRIBUTION_CORRECTED",
        "CONSENT_GRANTED",
        "CONSENT_WITHDRAWN",
        "STORY_RELEASED",
        "STORY_DISPOSITION_APPENDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "nominee_profile",
        "honor_nomination",
        "contribution_record",
        "achievement_review",
        "consent_grant",
        "public_story"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
